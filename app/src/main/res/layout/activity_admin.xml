<?xml version="1.0" encoding="utf-8"?>
<!-- Modern, Clean & Responsive Admin Dashboard Screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/txtAdminTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage bus stops, timetables and shared cloud database"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Route Badge -->
        <TextView
            android:id="@+id/txtAdminRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_badge"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/route_label"
            android:textColor="@color/badge_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Section: STOP MANAGEMENT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:text="STOP MANAGEMENT"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddStop"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="10dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_add_stop"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@color/color_primary"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditStop"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="10dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_edit_stop"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@color/color_secondary"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteStop"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_delete_stop"
            android:textColor="@color/error"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@color/error"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <!-- Section: TIMETABLE MANAGEMENT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="TIMETABLE MANAGEMENT"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageTimings"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="10dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_manage_timings"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_time"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@color/warning"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTimetable"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_view_timetable"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_route"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@color/color_primary"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_logout"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>
