<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Query for Maps intent (Unit 6) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/buslogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/buslogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.BusSathi">

        <!-- Main Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Student Activities -->
        <activity
            android:name=".BusScheduleActivity"
            android:exported="false"
            android:label="@string/btn_bus_schedule"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RouteActivity"
            android:exported="false"
            android:label="@string/btn_route_stops"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MyStopActivity"
            android:exported="false"
            android:label="@string/btn_my_stop"
            android:parentActivityName=".MainActivity" />

        <!-- Admin Activities -->
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false"
            android:label="@string/btn_admin_login"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:label="Admin Dashboard"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StopListActivity"
            android:exported="false"
            android:label="Manage Stops"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".StopFormActivity"
            android:exported="false"
            android:label="Stop Details"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".ManageTimingsActivity"
            android:exported="false"
            android:label="@string/btn_manage_timings"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".ViewTimetableActivity"
            android:exported="false"
            android:label="@string/btn_view_timetable"
            android:parentActivityName=".AdminActivity" />

    </application>

</manifest>